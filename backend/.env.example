#──────────────────────────────────────────────────────────────
# Sancta — variáveis de ambiente
# Copie para .env e preencha. NUNCA versione o arquivo .env.
#──────────────────────────────────────────────────────────────
APP_NAME=Sancta
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

#──────────────── Banco de dados (MySQL 8+, InnoDB, utf8mb4) ────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sancta
DB_USERNAME=root
DB_PASSWORD=
DB_ENGINE=InnoDB

#──────────────── Sessão / cookies ────────────────
# Cookies seguros são automáticos com APP_URL em https:// (sempre ligados em produção).
# Em produção defina SESSION_DOMAIN=.seudominio.com.br
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="nao-responda@sancta.app.br"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

#──────────────── Sancta ────────────────
# Caminho do painel administrativo (troque para algo NÃO óbvio em produção, ex.: gestao-8f3k)
SANCTA_ADMIN_PATH=painel
# IPs/CIDRs permitidos no painel (vazio = todos). Ex.: 200.100.10.1,177.0.0.0/16
SANCTA_ADMIN_IPS=
# Exigir 2FA (aplicativo autenticador) para administradores
SANCTA_ADMIN_REQUIRE_MFA=false

# Primeiro super administrador criado pelo seeder (se a senha ficar vazia, uma senha forte é gerada e exibida no terminal)
SANCTA_ADMIN_NAME="Administrador"
SANCTA_ADMIN_EMAIL=admin@sancta.test
SANCTA_ADMIN_PASSWORD=

# Validade dos tokens da API do app (dias)
SANCTA_API_TOKEN_TTL_DAYS=60

# Content-Security-Policy apenas em modo "report-only" (útil ao ajustar o site)
SANCTA_CSP_REPORT_ONLY=false

# Gateway de pagamento SIMULADO para demonstração (só funciona com APP_ENV=local/testing; ignorado em produção)
SANCTA_FAKE_PAYMENTS=true

#──────────────── Google Sign-In ────────────────
# IDs de cliente OAuth aceitos no id_token (separados por vírgula: Android, iOS e Web)
GOOGLE_CLIENT_IDS=
# Client ID do tipo "Web" usado pelo app Android como serverClientId
GOOGLE_WEB_CLIENT_ID=

#──────────────── Mercado Pago (Pix e cartão no site) ────────────────
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
# "Assinatura secreta" do webhook (Suas integrações → Webhooks)
MERCADOPAGO_WEBHOOK_SECRET=

#──────────────── Google Play Billing (assinaturas no app) ────────────────
GOOGLE_PLAY_PACKAGE_NAME=com.maria.app_igreja
# Caminho ABSOLUTO do JSON da conta de serviço (fora da pasta pública!)
GOOGLE_PLAY_SERVICE_ACCOUNT=
# Audience esperada no token OIDC do Pub/Sub (normalmente a URL do webhook)
GOOGLE_PLAY_RTDN_AUDIENCE=
GOOGLE_PLAY_RTDN_SERVICE_ACCOUNT_EMAIL=

#──────────────── Firebase Cloud Messaging (push) ────────────────
FCM_PROJECT_ID=app-paroquia-775b6
# Caminho ABSOLUTO do JSON da conta de serviço do Firebase
FCM_SERVICE_ACCOUNT=

#──────────────── IA (explicação de versículos — recurso Sancta+) ────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

#──────────────── YouTube (detecção automática de transmissões ao vivo) ────────────────
# Opcional (também editável no painel → Integrações e segurança → Conteúdo).
# Google Cloud → ative a "YouTube Data API v3" → Credenciais → Chave de API (restrinja à YouTube Data API v3).
# Sem chave, o status "ao vivo" segue a agenda cadastrada em cada canal.
YOUTUBE_API_KEY=

#──────────────── Liturgia diária ────────────────
LITURGIA_API_URL=https://liturgia.up.railway.app/
