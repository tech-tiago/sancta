<?xml version="1.0" encoding="utf-8"?>
<!-- Widget "Oração do dia" (4x2, como no mockup aprovado): cartão Azul Manto, céu em arco à esquerda,
     data, título, duração e botão play. Os textos abaixo são o conteúdo da prévia/inicial; o
     OracaoDoDiaWidgetProvider preenche o conteúdo real. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:padding="@dimen/widget_padding">

    <LinearLayout
        android:id="@+id/widget_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_sky"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:scaleType="fitStart"
            android:src="@drawable/widget_sky_aurora" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="Hoje"
                android:textColor="@color/widget_nevoa"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:maxLines="2"
                android:text="@string/widget_oracao_label"
                android:textColor="@color/widget_pergaminho"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_subtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginBottom="2dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="@string/widget_play"
                    android:textColor="@color/widget_nevoa"
                    android:textSize="12sp" />

                <ImageView
                    android:id="@+id/widget_play"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="@string/widget_play"
                    android:src="@drawable/widget_play" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
