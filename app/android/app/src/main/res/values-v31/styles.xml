<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (SplashScreen API). Dono: Motion — docs/design/MOTION.md. Igual no claro e no escuro.

  - Fundo Azul Manto e o Portal estático (sancta_portal_splash: 288 dp, Portal de 110 dp no centro,
    dentro do círculo de 192 dp) — o mesmo quadro com que a abertura em Flutter começa. Estático de
    propósito: a duração do splash do sistema é imprevisível e uma animação nativa cortada no meio
    "pularia" na troca para o Flutter; a luz e o movimento acontecem na abertura em Flutter.
  - icon_preferred (Android 13+): mostra o Portal também quando o app é aberto por notificação/atalho.
  - windowBackground = launch_background (mesmo Portal, mesma posição) como rede de segurança entre o
    fim do splash do sistema e o primeiro quadro do Flutter.
-->
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/sancta_splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/sancta_portal_splash</item>
        <item name="android:windowSplashScreenBehavior" tools:targetApi="33">icon_preferred</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/sancta_splash_background</item>
        <item name="android:navigationBarColor">@color/sancta_splash_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/sancta_splash_background</item>
    </style>
</resources>
