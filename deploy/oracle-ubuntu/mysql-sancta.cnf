# Sancta — ajustes do MySQL, instalado em /etc/mysql/mysql.conf.d/zz-sancta.cnf
# (lido depois do mysqld.cnf, então estes valores prevalecem).

[mysqld]
# Só a própria máquina acessa o banco; a porta 3306 nunca fica exposta.
bind-address = 127.0.0.1
mysqlx-bind-address = 127.0.0.1

# 12 GB de RAM: 2 GB de cache para o banco (que é pequeno) e o resto para o PHP e o sistema.
innodb_buffer_pool_size = 2G
max_connections = 100

# Logs binários por 3 dias (o padrão de 30 dias só ocupa disco; o backup diário cobre o resto).
binlog_expire_logs_seconds = 259200
