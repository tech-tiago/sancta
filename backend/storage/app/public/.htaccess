# Arquivos enviados (servidos em /storage): nunca executar nem interpretar como página.
# Mesmo que um arquivo ativo escape da validação, o navegador o abre isolado (sem scripts).
Options -Indexes -ExecCGI
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Content-Security-Policy "default-src 'none'; img-src 'self' data:; media-src 'self'; style-src 'unsafe-inline'; sandbox"
</IfModule>
<FilesMatch "\.(php|phtml|phar|php\d)$">
    Require all denied
</FilesMatch>
